# URL API с префиксом версии, без /chat/completions в конце.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.4-mini

# Пустой URL STT наследуется от LLM. Ключ наследуется при совпадении адресов сервиса.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=gpt-transcribe
TRANSCRIPTION_MODE=transcriptions

# openai, elevenlabs или espeak (локальная озвучка, TTS_VOICE=ru).
# Пустой URL для openai наследуется от LLM. Ключ наследуется при совпадении адресов сервиса.
TTS_PROVIDER=openai
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

PORT=3000
